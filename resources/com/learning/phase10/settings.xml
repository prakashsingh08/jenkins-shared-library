<?xml version="1.0" encoding="UTF-8"?>
<!--
  Generated by the shared library. Written to the workspace, used by one mvn deploy,
  then deleted.

  TWO DIFFERENT PLACEHOLDER STYLES HERE, ON PURPOSE:

    @SERVER_ID@        replaced by the library with .replace() before writing.
                       Fine: the server id is not a secret.

    ${env.CS_USER}     NOT replaced by anyone in Groovy. Maven itself resolves
    ${env.CS_PASS}     ${env.X} from its own environment when it reads this file.

  Why the second style for the secret: if Groovy substituted the password, the real
  password would sit in this file on disk, and any later `cat` or archiveArtifacts
  would expose it. This way the file only ever contains the TEXT "${env.CS_PASS}",
  and the value exists solely in the environment of the mvn process.
-->
<settings>
  <servers>
    <server>
      <id>@SERVER_ID@</id>
      <username>${env.CS_USER}</username>
      <password>${env.CS_PASS}</password>
    </server>
  </servers>
</settings>
